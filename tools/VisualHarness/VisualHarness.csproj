<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ferramenta de desenvolvimento: renderiza as páginas reais do WinCore Manager em PNG. NÃO faz parte do pacote. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en;en-US</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinCoreManager\WinCoreManager.csproj" />
  </ItemGroup>
</Project>
