<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        xmlns:vm="clr-namespace:WinCoreManager.ViewModels"
        xmlns:views="clr-namespace:WinCoreManager.Views"
        xmlns:h="clr-namespace:WinCoreManager.Helpers"
        Title="WinCore Manager"
        Width="1280"
        Height="820"
        MinWidth="840"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        FontSize="14">

    <Window.Resources>
        <h:ResourceKeyConverter x:Key="IconByKey" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenancePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UninstallersViewModel}">
            <views:UninstallersPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwarePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorPanelViewModel}">
            <views:SensorPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EssentialsViewModel}">
            <views:EssentialsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Marca -->
                <Grid DockPanel.Dock="Top" Margin="18,14,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusMd}" Padding="3"
                            Background="{DynamicResource TileBlueBrush}" BorderBrush="{DynamicResource GlowBorderBrush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/WinCoreManager;component/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="WinCore Manager" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinCore Manager" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="BrandTagline" Text="{loc:Loc Shell.Tagline}" Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Rodapé: montanhas atrás do topo dos links -->
                <Grid DockPanel.Dock="Bottom">
                    <Image x:Name="SidebarArt" Source="pack://application:,,,/WinCoreManager;component/Assets/Nebula/montanhas-painel.png"
                           Stretch="Uniform" VerticalAlignment="Top" Opacity="{DynamicResource ArtOpacity}" IsHitTestVisible="False" />
                    <StackPanel x:Name="FooterNav" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Localized About.LinkMessage}" TextWrapping="Wrap" Margin="20,0"
                                   AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="FixMyPcLink" Content="{loc:Loc UI.TryFixMyPC}" Tag="{StaticResource Icon.External}"
                                Command="{Binding About.OpenFixMyPcCommand}" Style="{StaticResource NavLinkButton}" />
                        <RadioButton x:Name="AboutNav" Content="{loc:Localized AboutNavItem.Title}" Tag="{StaticResource Icon.Info}"
                                     GroupName="nav" IsChecked="{Binding AboutNavItem.IsSelected, Mode=TwoWay}"
                                     Style="{StaticResource NavRadioButton}" />
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource CaptionText}" Margin="28,2,12,0">
                            <Run Text="{loc:Loc UI.Version}" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Navegação -->
                <ScrollViewer x:Name="MainNavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavItems}"
                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                  VerticalAlignment="Top" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{loc:Localized Title}"
                                             Tag="{Binding Glyph, Converter={StaticResource IconByKey}}"
                                             GroupName="nav"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Style="{StaticResource NavRadioButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource PageGradientBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" IsTabStop="False" />
        </Border>
    </Grid>
</Window>
