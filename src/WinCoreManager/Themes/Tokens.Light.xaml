<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- WinCore Manager — skin Light (cinza neutro e azul contido). Mesmas chaves em Tokens.Dark.xaml e Tokens.Light.xaml (teste garante a paridade). -->

    <!-- surfaces -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#EEEFF1" />   <!-- barra lateral e barra de título -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F6F7F8" />   <!-- canvas das páginas (BackgroundPrimary) -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />   <!-- cartões, tabelas, campos (SurfacePrimary) -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8F9FA" />   <!-- cartão clicável em hover -->
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#F1F2F4" />   <!-- faixas internas (BackgroundSecondary) -->
    <SolidColorBrush x:Key="InsetBgBrush" Color="#EFF0F2" />   <!-- áreas rebaixadas: log, bloco de comando, caixa do checkbox -->
    <SolidColorBrush x:Key="PopupBgBrush" Color="#FFFFFF" />   <!-- popups, tooltips, menus (SurfaceElevated) -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#F3F4F6" />   <!-- botão secundário -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F2F4F7" />   <!-- linha de tabela em hover -->
    <SolidColorBrush x:Key="RowAltBrush" Color="#06000000" />   <!-- zebra -->
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#0D000000" />   <!-- camada de hover (nav, checkbox) -->

    <!-- borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E2E6" />   <!-- 1px padrão de cartão/divisor (BorderDefault) -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBCED4" />   <!-- bordas de botão -->
    <SolidColorBrush x:Key="BorderControlBrush" Color="#6E727A" />   <!-- contorno de campos e caixas (3:1) -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#E8EAED" />   <!-- divisores internos -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7F838B" />   <!-- barra de rolagem -->
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6E76" />   <!-- barra de rolagem em hover -->
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#565A62" />   <!-- barra de rolagem arrastada -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#D3D6DB" />   <!-- trilho do interruptor desligado -->

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#565A62" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5E626A" />   <!-- placeholder e legendas terciárias (>=4.5:1) -->
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9B9EA6" />   <!-- somente desabilitado -->

    <!-- accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2B67BF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2359A8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4C91" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />   <!-- texto sobre acento -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#22569F" />   <!-- acento como texto/ícone/foco (FocusBorder) -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E6ECF6" />   <!-- fundo de seleção (SelectionBackground) -->
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#DAE3F2" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#B0C3E2" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E6ECF6" />

    <!-- semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1D7440" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E4F2E9" />
    <SolidColorBrush x:Key="WarningBrush" Color="#93590A" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FBF1DE" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E2A7A1" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FBEBE9" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A22F23" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#E6ECF6" />   <!-- aviso informativo -->

    <!-- cores brutas (gradiente do progresso indeterminado e sombra de popups) -->
    <Color x:Key="AccentColor">#2B67BF</Color>
    <Color x:Key="AccentColorClear">#002B67BF</Color>
    <Color x:Key="ShadowColor">#1B1D21</Color>
    <sys:Double x:Key="PopupShadowOpacity">0.16</sys:Double>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
</ResourceDictionary>
