<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- WinCore Manager — skin Dark (grafite neutro). Mesmas chaves em Tokens.Dark.xaml e Tokens.Light.xaml (teste garante a paridade). -->

    <!-- surfaces -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#16171A" />   <!-- barra lateral e barra de título -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#1B1C20" />   <!-- canvas das páginas (BackgroundPrimary) -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#232428" />   <!-- cartões, tabelas, campos (SurfacePrimary) -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#292B30" />   <!-- cartão clicável em hover -->
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#1F2024" />   <!-- faixas internas (BackgroundSecondary) -->
    <SolidColorBrush x:Key="InsetBgBrush" Color="#17181B" />   <!-- áreas rebaixadas: log, bloco de comando, caixa do checkbox -->
    <SolidColorBrush x:Key="PopupBgBrush" Color="#2C2E33" />   <!-- popups, tooltips, menus (SurfaceElevated) -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#2B2D32" />   <!-- botão secundário -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2A2C31" />   <!-- linha de tabela em hover -->
    <SolidColorBrush x:Key="RowAltBrush" Color="#08FFFFFF" />   <!-- zebra -->
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#0FFFFFFF" />   <!-- camada de hover (nav, checkbox) -->

    <!-- borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#34363C" />   <!-- 1px padrão de cartão/divisor (BorderDefault) -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#44474E" />   <!-- bordas de botão -->
    <SolidColorBrush x:Key="BorderControlBrush" Color="#8A8D95" />   <!-- contorno de campos e caixas (3:1) -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#2B2D32" />   <!-- divisores internos -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7A7D85" />   <!-- barra de rolagem -->
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9497A0" />   <!-- barra de rolagem em hover -->
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#A9ACB4" />   <!-- barra de rolagem arrastada -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#2C2E33" />   <!-- trilho do interruptor desligado -->

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8ABB3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E9199" />   <!-- placeholder e legendas terciárias (>=4.5:1) -->
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5F6269" />   <!-- somente desabilitado -->

    <!-- accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6A97DB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7FA6E2" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5883C6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B121D" />   <!-- texto sobre acento -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#8FB4EC" />   <!-- acento como texto/ícone/foco (FocusBorder) -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#262C37" />   <!-- fundo de seleção (SelectionBackground) -->
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#2D3544" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#43597F" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#262C37" />

    <!-- semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6DBD7C" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1B2A20" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E0B650" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#2E2913" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DD6A5F" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F0908A" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#7E3F3B" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2E1E1F" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C4463C" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#212935" />   <!-- aviso informativo -->

    <!-- cores brutas (gradiente do progresso indeterminado e sombra de popups) -->
    <Color x:Key="AccentColor">#6A97DB</Color>
    <Color x:Key="AccentColorClear">#006A97DB</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="PopupShadowOpacity">0.5</sys:Double>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
</ResourceDictionary>
