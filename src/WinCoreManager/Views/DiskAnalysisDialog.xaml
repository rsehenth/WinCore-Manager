<Window x:Class="WinCoreManager.Views.DiskAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Title="{loc:Loc DiskSpace.Title}" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="OnLoaded"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="{loc:Loc DiskSpace.Title}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc DiskSpace.ConfigureIntro}" Style="{StaticResource PageSubtitleText}"
                       TextWrapping="Wrap" Margin="0,5,0,14" />
            <Border Style="{StaticResource CardBorder}" Padding="14,10">
                <StackPanel>
                    <RadioButton x:Name="OneDrive" IsChecked="True" GroupName="Scope" Checked="OnScopeChanged"
                                 Content="{loc:Loc DiskSpace.OneDrive}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox x:Name="Drives" DisplayMemberPath="Display" SelectionChanged="OnDriveChanged"
                              AutomationProperties.Name="{loc:Loc DiskSpace.Drive}" Margin="20,5,0,7" />
                    <RadioButton x:Name="AllDrives" GroupName="Scope" Checked="OnScopeChanged" Margin="0,4,0,0"
                                 Content="{loc:Loc DiskSpace.AllDrives}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <RadioButton x:Name="OneFolder" GroupName="Scope" Checked="OnScopeChanged" Margin="0,9,0,0"
                                 Content="{loc:Loc DiskSpace.OneFolder}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <DockPanel x:Name="FolderPicker" Margin="20,5,0,0" LastChildFill="True">
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="{loc:Loc DiskSpace.Browse}" Click="OnBrowse" Margin="8,0,0,0" />
                        <TextBlock x:Name="FolderPath" Text="{loc:Loc DiskSpace.NoFolder}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,9,0,0">
                <StackPanel>
                    <CheckBox x:Name="Fast" Content="{loc:Loc DiskSpace.Fast}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc DiskSpace.FastHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="20,3,0,8" />
                    <CheckBox x:Name="Duplicates" Content="{loc:Loc DiskSpace.FindDuplicates}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc DiskSpace.DuplicatesHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="20,3,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SetupStatus" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button IsCancel="True" Content="{loc:Loc DiskSpace.CancelSetup}" Margin="0,0,8,0" />
                <Button x:Name="Begin" IsDefault="True" Content="{loc:Loc DiskSpace.Start}" Style="{StaticResource PrimaryButton}" Click="OnBegin" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
