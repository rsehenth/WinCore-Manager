<UserControl x:Class="WinCoreManager.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers">

    <UserControl.Resources>
        <h:HistoryStatusToBrushConverter x:Key="StatusToBrush" />
        <h:HistoryTypeToLabelConverter x:Key="TypeToLabel" />
        <h:HistoryStatusToLabelConverter x:Key="StatusToLabel" />
        <h:DurationConverter x:Key="Duration" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <HeaderedContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.History}">
                <HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Localized StatusText}" Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </HeaderedContentControl.Header>
            </HeaderedContentControl>
        </StackPanel>

        <!-- Filtros -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="{loc:Loc UI.ClearHistory}"
                    Style="{StaticResource DangerOutlineButton}"
                    Command="{Binding ClearHistoryCommand}"
                    VerticalAlignment="Top" Margin="8,0,0,4" />

            <WrapPanel>
                <ComboBox
                          ItemsSource="{Binding TypeOptions}"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                          ItemTemplate="{StaticResource LocalizedLabelTemplate}"
                          Width="160"
                          Margin="0,0,8,4"
                          Tag="{loc:Loc Message.AllTypes}"
                          AutomationProperties.Name="{loc:Loc UI.FilterByType}"
                          VerticalAlignment="Center" />

                <ComboBox
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          ItemTemplate="{StaticResource LocalizedLabelTemplate}"
                          Width="196"
                          Margin="0,0,8,4"
                          Tag="{loc:Loc Message.AllResults}"
                          AutomationProperties.Name="{loc:Loc UI.FilterByStatus}"
                          VerticalAlignment="Center" />

                <Grid Width="260" Margin="0,0,8,4">
                    <TextBox x:Name="HistorySearchBox"
                             Padding="34,0,10,0"
                             AutomationProperties.Name="{loc:Loc UI.SearchHistory}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;"
                               Style="{StaticResource IconText}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{loc:Loc UI.SearchHistory2}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="34,0,10,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardBorder}" Padding="0,0,0,6">
                <DataGrid ItemsSource="{Binding Records}"
                          VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Margin="6,0"
                          IsReadOnly="True"
                          RowHeight="38"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          AutomationProperties.Name="{loc:Loc UI.OperationHistory}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ToolTip" Value="{loc:Localized Message}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc UI.DateAndTime}"
                                            Binding="{loc:Localized Timestamp, NumberFormat=G}"
                                            Width="160" MinWidth="128"
                                            CanUserResize="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc UI.Type}"
                                            Binding="{loc:Localized Type, Converter={StaticResource TypeToLabel}}"
                                            Width="110" MinWidth="78" />
                        <DataGridTextColumn Header="{loc:Loc UI.Target}" Binding="{Binding Target}" Width="200" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Target}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc UI.Details}" Binding="{loc:Localized Details}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{loc:Localized Details}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status: glifo + texto com a cor semântica -->
                        <DataGridTemplateColumn Header="{loc:Loc UI.Status}" Width="120" MinWidth="106" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="statusIcon"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="12"
                                                   Width="14"
                                                   Margin="0,0,8,0"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{loc:Localized Status, Converter={StaticResource StatusToLabel}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                            <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failure">
                                            <Setter TargetName="statusIcon" Property="Text" Value="&#xE711;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter TargetName="statusIcon" Property="Text" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{loc:Loc UI.Code}"
                                            Binding="{Binding ExitCode}"
                                            Width="80" MinWidth="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc UI.Duration}"
                                            Binding="{loc:Localized DurationMs, Converter={StaticResource Duration}, Translate=False}"
                                            Width="90" MinWidth="76">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Estado vazio -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,36,0,0"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Records.Count}" Value="0" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Image Source="pack://application:,,,/WinCoreManager;component/Assets/Nebula/empty-history.png" Width="150" Stretch="Uniform" />
                <TextBlock Text="{loc:Loc UI.NoRecordsFound}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="{loc:Loc UI.UpdatesAndMaintenanceOperationsWillAppearHereAdjust}"
                           Style="{StaticResource CaptionText}"
                           FontSize="13"
                           TextAlignment="Center"
                           MaxWidth="380"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
