<UserControl x:Class="WinCoreManager.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StartupCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="StartupFeedback" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="56" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc UI.SeeWhatStartsWithWindowsAndManageEligible}"
                       Style="{StaticResource PageSubtitleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,8">
            <WrapPanel>
                <Grid Width="210" Margin="0,0,8,6">
                    <TextBox x:Name="StartupSearch" Padding="34,0,10,0"
                             AutomationProperties.Name="{loc:Loc UI.SearchByNamePublisherOrPath}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Margin="12,0,0,0" />
                    <TextBlock Text="{loc:Loc UI.SearchApps}" IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="34,0,6,0" Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=StartupSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox x:Name="StatusFilter" MinWidth="102" AutomationProperties.Name="{loc:Loc UI.FilterByStatus}"
                          Margin="0,0,8,6" ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" ItemTemplate="{StaticResource LocalizedLabelTemplate}" />
                <ComboBox x:Name="OriginFilter" Width="176" AutomationProperties.Name="{loc:Loc UI.FilterBySource}"
                          Margin="0,0,8,6" ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource}" ItemTemplate="{StaticResource LocalizedLabelTemplate}" />
                <Button Content="{loc:Loc UI.Refresh}" Command="{Binding RefreshCommand}" Padding="12,0" Margin="0,0,8,6" />
                <Button Content="{loc:Loc UI.Cancel}" Command="{Binding CancelCommand}" Padding="12,0" Margin="0,0,0,6"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Text="{loc:Localized CountText}" Style="{StaticResource CaptionText}" />
            <TextBlock Text="{loc:Localized Message}" Style="{StaticResource StartupFeedback}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{loc:Localized Warning}" Style="{StaticResource StartupFeedback}"
                       ToolTip="{loc:Localized Warning}" MaxHeight="38" Foreground="{DynamicResource WarningBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="StartupGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" RowHeight="42"
                      EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      HeadersVisibility="Column" AutomationProperties.Name="{loc:Loc UI.StartupEntries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc UI.App2}" Binding="{Binding Name}" Width="1.2*" MinWidth="97"
                                        ElementStyle="{StaticResource StartupCell}" />
                    <DataGridTextColumn Header="{loc:Loc UI.Publisher}" Binding="{Binding Publisher}" Width="*" MinWidth="82"
                                        ElementStyle="{StaticResource StartupCell}" />
                    <DataGridTemplateColumn Header="{loc:Loc UI.Status}" Width="172" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Estado = cor + glifo + texto (nunca só cor). -->
                                <Grid ToolTip="{loc:Localized Status}" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style x:Key="StatusInk" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock FontFamily="{StaticResource FontIcons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusInk}">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                        <Setter Property="Text" Value="&#xE711;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{loc:Localized Status}" TextWrapping="Wrap" Style="{StaticResource StatusInk}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc UI.Source}" Binding="{loc:Localized Source}" Width="*" MinWidth="77"
                                        ElementStyle="{StaticResource StartupCell}" />
                    <DataGridTextColumn Header="{loc:Loc UI.FilePath}" Binding="{loc:Localized FilePath}" Width="1.6*" MinWidth="120"
                                        ElementStyle="{StaticResource StartupCell}" />
                    <DataGridTemplateColumn Header="{loc:Loc UI.Control}" Width="150" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Localized Action}" Padding="8,0" HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{loc:Localized Details}"
                                        ToolTip="{loc:Localized Details}" ToolTipService.ShowOnDisabled="True"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="{Binding Entry.CanChange}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanManageInWindows}" Value="True">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Command" Value="{Binding DataContext.OpenNativeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" x:Name="EntryDetails" Style="{StaticResource CardBorder}" Padding="12,8"
                Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Loc UI.OpenFileLocation}"
                            Command="{Binding OpenLocationCommand}" Padding="10,0" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource SectionText}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="83" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"><Run Text="{loc:Loc UI.Source2}" /><Run Text="{loc:Localized SelectedRow.Location}" /></TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"><Run Text="{loc:Loc UI.File}" /><Run Text="{Binding SelectedRow.FilePath, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"><Run Text="{loc:Loc UI.Arguments}" /><Run Text="{Binding SelectedRow.Arguments, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{loc:Localized SelectedRow.OriginalCommand}" Style="{StaticResource StartupFeedback}" />
                        <TextBlock Text="{loc:Localized SelectedRow.Details}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
