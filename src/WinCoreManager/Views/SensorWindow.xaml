<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.SensorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        xmlns:views="clr-namespace:WinCoreManager.Views"
        Title="{loc:Loc UI.SensorsWinCoreManager}" Width="760" Height="620" MinWidth="380" MinHeight="250"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}" FontSize="14">
    <views:SensorPanel />
</Window>
