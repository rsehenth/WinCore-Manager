<UserControl x:Class="WinCoreManager.Views.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:views="clr-namespace:WinCoreManager.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBooleanConverter x:Key="InverseBool" />
        <h:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <DataTemplate x:Key="ToolCardTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="34" Height="34" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}"
                                   Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <WrapPanel>
                            <TextBlock Text="{loc:Localized DisplayName}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc Maintenance.Admin}" Style="{StaticResource CaptionText}" Margin="8,1,0,0"
                                       Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                        <TextBlock Text="{loc:Localized CardDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <Button Content="{loc:Localized ActionLabel}" HorizontalAlignment="Left"
                                AutomationProperties.Name="{loc:Localized DisplayName}"
                                AutomationProperties.HelpText="{loc:Localized DisplayCommand, FormatKey=Common.Command}"
                                Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1320">

            <StackPanel Margin="0,0,0,18">
                <HeaderedContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Wrench}" Margin="0">
                    <HeaderedContentControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="{loc:Localized StatusText}" Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </HeaderedContentControl.Header>
                </HeaderedContentControl>
                <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,8,0,0"
                        Visibility="{Binding PendingRecoveryNotice, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UpdateOperation.RecoveryMaintenanceBlocked}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Localized PendingRecoveryNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc Message.PackageAction.OpenUpdates}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Reparo Completo -->
            <Border Style="{StaticResource CardBorder}"
                    Background="{DynamicResource TileBlueBrush}"
                    BorderBrush="{DynamicResource GlowBorderBrush}"
                    Margin="0,0,0,16"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE90F;"
                                   Style="{StaticResource IconText}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc UI.FullRepair}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Loc UI.RunsDISMRestoreHealthThenSFCScannowIfDISM}"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   MaxWidth="560"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{loc:Loc UI.StartFullRepair}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunFullRepairCommand}"
                            ToolTip="{loc:Localized PendingRecoveryNotice, NullText={x:Null}}"
                            AutomationProperties.HelpText="{loc:Localized PendingRecoveryNotice}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Progresso (logo abaixo do reparo para ficar visível durante a execução) -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16,14"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Localized CurrentOperation}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc UI.Cancel}"
                                Command="{Binding CancelCommand}"
                                Margin="16,0,0,0" />
                    </Grid>
                    <ProgressBar Margin="0,12,0,0"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="{loc:Loc UI.MaintenanceProgress}" />
                </StackPanel>
            </Border>

            <!-- Log -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,0,0,16"
                    Height="190"
                    Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0"
                            Height="32">
                        <TextBlock Text="{loc:Loc UI.Log}" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="16,10">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{loc:Localized .}"
                                               Style="{StaticResource MonoText}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Ferramentas individuais -->
            <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolCardTemplate}" Margin="0,0,-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <h:TileGrid MinItemWidth="360" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <views:DiskHealthCard Detailed="True" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
