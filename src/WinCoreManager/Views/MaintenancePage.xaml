<UserControl x:Class="WinCoreManager.Views.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBooleanConverter x:Key="InverseBool" />

        <!-- Cartão de ferramenta: botão com borda de acento no hover e glifo de execução. -->
        <Style x:Key="ToolCardButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="layoutRoot">
                            <VisualStateManager.CustomVisualStateManager>
                                <h:MotionVisualStateManager />
                            </VisualStateManager.CustomVisualStateManager>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14" GeneratedEasingFunction="{StaticResource EaseOut}" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="runGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="runGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="layoutRoot" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLg}" />
                            <Border x:Name="stateLayer"
                                    Background="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="hoverBorder"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                            <TextBlock x:Name="runGlyph"
                                       Text="&#xE768;"
                                       Style="{StaticResource IconText}"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,16,18,0"
                                       Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToolCardTemplate">
            <Button Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource ToolCardButton}"
                    ToolTip="{loc:Localized Description}"
                    Margin="0,0,12,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Localized DisplayName}" FontWeight="SemiBold" FontSize="15" />
                        <Border Style="{StaticResource WarningBadge}"
                                Margin="10,0,0,0"
                                Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc UI.AdministratorApprovalRequired}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Localized Description}"
                               Style="{StaticResource CaptionText}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               MaxHeight="54"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource InsetBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="10,6"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Localized DisplayCommand, FormatKey=Common.Command}"
                                   Style="{StaticResource MonoText}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Localized StatusText}"
                           Style="{StaticResource PageSubtitleText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Reparo Completo -->
            <Border Style="{StaticResource CardBorder}"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Margin="0,0,0,16"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE90F;"
                                   Style="{StaticResource IconText}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc UI.FullRepair}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Loc UI.RunsDISMRestoreHealthThenSFCScannowIfDISM}"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   MaxWidth="560"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{loc:Loc UI.StartFullRepair}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunFullRepairCommand}"
                            ToolTip="{Binding DataContext.Updates.PackageChangeBlockReason, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Progresso (logo abaixo do reparo para ficar visível durante a execução) -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16,14"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Localized CurrentOperation}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc UI.Cancel}"
                                Command="{Binding CancelCommand}"
                                Margin="16,0,0,0" />
                    </Grid>
                    <ProgressBar Margin="0,12,0,0"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="{loc:Loc UI.MaintenanceProgress}" />
                </StackPanel>
            </Border>

            <!-- Log -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,0,0,16"
                    Height="190"
                    Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0"
                            Height="32">
                        <TextBlock Text="{loc:Loc UI.Log}" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="16,10">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{loc:Localized .}"
                                               Style="{StaticResource MonoText}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Ferramentas individuais -->
            <ItemsControl ItemsSource="{Binding Tools}"
                          Margin="0,0,-12,0"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                          ItemTemplate="{StaticResource ToolCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
