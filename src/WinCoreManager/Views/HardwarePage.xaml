<UserControl x:Class="WinCoreManager.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:hardware="clr-namespace:WinCoreManager.Services.Hardware">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <DataTemplate DataType="{x:Type hardware:HardwareDevice}">
            <StackPanel Margin="0,8,0,4">
                <TextBlock Text="{loc:Localized .}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="7*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Localized Label}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{loc:Localized .}" TextWrapping="Wrap" ToolTip="{loc:Localized Source}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Children}" Margin="14,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="HardwareScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1060">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="WindowsSummaryText" Text="{loc:Localized WindowsSummary}" Style="{StaticResource PageSubtitleText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="SensorsButton" Grid.Column="1" Content="{loc:Loc UI.Sensors}" Style="{StaticResource AppButton}"
                        VerticalAlignment="Top" Click="OnOpenSensors" />
            </Grid>

            <WrapPanel Margin="0,0,0,8">
                <Button Content="{loc:Loc UI.RefreshInventory}" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
                <Button Content="{loc:Loc UI.CancelScan}" Command="{Binding RefreshCancelCommand}" Margin="0,0,8,4"
                        Visibility="{Binding IsReading, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Text="{loc:Localized Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>

            <ItemsControl x:Name="HardwareSummary" ItemsSource="{Binding SummaryCards}" Margin="0,0,-8,3">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{loc:Localized Title}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Localized Summary}" Style="{StaticResource ValueText}" FontSize="16" Margin="0,4,0,0" />
                                <TextBlock Text="{loc:Localized Status}" Style="{StaticResource OptionalCaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="HardwareSections" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="14,6">
                            <Expander Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="{loc:Localized Title}">
                                <Expander.Header>
                                    <StackPanel Margin="4,5,6,5">
                                        <TextBlock Text="{loc:Localized Title}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{loc:Localized Status}" Style="{StaticResource OptionalCaptionText}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Devices}" Margin="8,0,4,5" />
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
