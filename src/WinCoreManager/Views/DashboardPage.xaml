<UserControl x:Class="WinCoreManager.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers"
             xmlns:m="clr-namespace:WinCoreManager.Models">

    <UserControl.Resources>
        <h:HistoryStatusToBrushConverter x:Key="StatusToBrush" />
        <h:HistoryTypeToLabelConverter x:Key="TypeToLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <h:HistoryStatusToLabelConverter x:Key="StatusToLabel" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1040" HorizontalAlignment="Stretch">

            <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc UI.SystemAndWinGetStatusAtAGlance}"
                       Style="{StaticResource PageSubtitleText}"
                       Margin="0,4,0,20" />

            <!-- Atualizações -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE895;"
                                   Style="{StaticResource IconText}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc UI.Updates}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Localized UpdatesSummaryText}"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{loc:Localized WingetStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{loc:Loc UI.OpenUpdates}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GoToUpdatesCommand}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Manutenção -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE90F;"
                                   Style="{StaticResource IconText}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc UI.Maintenance}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Localized MaintenanceStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{loc:Loc UI.OpenMaintenance}"
                            Command="{Binding GoToMaintenanceCommand}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Atividade recente -->
            <Border Style="{StaticResource CardBorder}" Padding="20,16,20,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc UI.RecentActivity}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                        <Button Content="{loc:Loc UI.OpenHistory}"
                                Command="{Binding GoToHistoryCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Localized Timestamp, NumberFormat=G}"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{loc:Localized Type, Converter={StaticResource TypeToLabel}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Target}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Target}" />
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="statusIcon"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="12"
                                                       Margin="0,0,6,0"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{loc:Localized Status, Converter={StaticResource StatusToLabel}}"
                                                       FontSize="13"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                        <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failure">
                                        <Setter TargetName="statusIcon" Property="Text" Value="&#xE711;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter TargetName="statusIcon" Property="Text" Value="&#xE71A;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado vazio -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE81C;"
                                   Style="{StaticResource IconText}"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc UI.NoActivityRecordedYetUpdatesAndMaintenanceOperations}"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                            <TextBlock Text="&#xE770;" Style="{StaticResource IconText}"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc WindowsCard.Title}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Activation.Name}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,14,0,4">
                        <StackPanel MinWidth="120" Margin="0,0,24,8">
                            <TextBlock Text="{loc:Loc WindowsCard.Edition}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Activation.Edition}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="110" Margin="0,0,24,8">
                            <TextBlock Text="{loc:Loc WindowsCard.Version}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Activation.DisplayVersion}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="90" Margin="0,0,24,8">
                            <TextBlock Text="{loc:Loc WindowsCard.Build}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Activation.Build}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc WindowsCard.Status}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Activation.StatusText}" FontWeight="SemiBold" Margin="0,3,0,0"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activation.Snapshot.State}" Value="Activated">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Activation.Snapshot.State}" Value="NotActivated">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Activation.Snapshot.State}" Value="Grace">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Activation.Checking}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel>
                        <Button x:Name="ActivateWindowsButton" Content="{loc:Loc WindowsCard.Activate}"
                                Click="OpenActivationRepository" IsEnabled="{Binding Activation.CanActivate}"
                                Visibility="{Binding Activation.ShowActivate, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Loc WindowsCard.OpenRepository}" Margin="0,0,8,4" />
                        <Button x:Name="ActivationSettingsButton" Content="{Binding Activation.SettingsLabel}"
                                Command="{Binding Activation.OpenSettingsCommand}" Margin="0,0,8,4" />
                        <Button x:Name="RefreshActivationButton" Content="{loc:Loc WindowsCard.Refresh}"
                                Command="{Binding Activation.RefreshCommand}" Margin="0,0,0,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Activation.OpenFailureText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerTextBrush}" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Activation.OpenFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
