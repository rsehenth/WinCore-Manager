<UserControl x:Class="WinCoreManager.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization">
    <UserControl.Resources>
        <!-- Uma linha por ajuste: nome, estado atual e explicação à esquerda; seletor e Aplicar à direita (quebra em janelas estreitas). -->
        <DataTemplate x:Key="TweakRowTemplate">
            <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Localized Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Localized Details}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource LocalizedLabelTemplate}" IsEnabled="{Binding CanEdit}" MinWidth="150" MaxWidth="270"
                                  AutomationProperties.Name="{loc:Localized Label}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc UI.Apply}" Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="TweaksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1040">
            <HeaderedContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Sliders}">
                <HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc UI.ReviewAndAdjustWindowsSettingsEachSettingShows}" Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </HeaderedContentControl.Header>
            </HeaderedContentControl>
            <WrapPanel Margin="0,0,0,4">
                <Button Content="{loc:Loc UI.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
                <Button x:Name="UndoTweakButton" Content="{loc:Loc UI.UndoLastChange}" Command="{Binding UndoCommand}" Margin="0,0,8,4" />
                <TextBlock Text="{loc:Localized UndoText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Text="{loc:Localized Status}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource WarningBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{loc:Localized Message}" Style="{StaticResource OptionalText}" AutomationProperties.LiveSetting="Polite" />

            <!-- Energia -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc UI.Power}" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="{loc:Loc UI.TheseTimeoutsApplyToTheActivePlanSwitch}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="PowerRows" ItemsSource="{Binding Power}" ItemTemplate="{StaticResource TweakRowTemplate}"
                                  IsEnabled="{Binding CanInteract}" />
                </StackPanel>
            </Border>

            <!-- Desempenho -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Tweaks.VisualTitle}" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="{loc:Loc Tweaks.VisualDescription}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="OpenPerformanceButton" Content="{loc:Loc Tweaks.VisualOpen}" HorizontalAlignment="Left"
                            Command="{Binding OpenPerformanceCommand}" />
                </StackPanel>
            </Border>

            <!-- Opções de Pasta -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc UI.FolderOptions}" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="{loc:Loc UI.FileExplorerPreferencesForTheCurrentUserWindows}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="FolderRows" ItemsSource="{Binding FolderOptions}" ItemTemplate="{StaticResource TweakRowTemplate}"
                                  IsEnabled="{Binding CanInteract}" />
                </StackPanel>
            </Border>

            <!-- Restauração do Sistema -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE777;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc UI.SystemRestore}" Style="{StaticResource CardTitleText}" />
                            <TextBlock x:Name="RestoreSummary" Text="{loc:Localized RestoreStatus}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Localized RestoreDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    <Button x:Name="OpenProtectionButton" Content="{loc:Loc UI.OpenSystemProtection}" HorizontalAlignment="Left"
                            Command="{Binding OpenProtectionCommand}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
