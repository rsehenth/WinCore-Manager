<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.ResidueCleanupConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        Title="{loc:Loc UI.ConfirmLeftoverCleanup}"
        Width="680"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        FontSize="14">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource GridLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc UI.Cancel}"
                        IsCancel="True"
                        IsDefault="True"
                        MinWidth="110"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Content="{loc:Loc UI.ConfirmCleanup}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="140"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,28,28,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Style="{StaticResource IconTile}" Background="{DynamicResource WarningSubtleBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE74D;"
                                   Style="{StaticResource IconText}"
                                   FontSize="18"
                                   Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{loc:Localized Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="520" />
                </StackPanel>

                <TextBlock Text="{loc:Localized Description}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="{loc:Loc UI.ItemsToProcessInOrder}"
                           Style="{StaticResource LabelText}"
                           Margin="0,0,0,6" />
                <Border Background="{DynamicResource InsetBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        MaxHeight="230"
                        Padding="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource FontMono}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ReviewedLocation}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,2">
                                        <Run Text="{loc:Localized CategoryLabel}" Foreground="{DynamicResource AccentTextBrush}" /><Run Text="  " /><Run Text="{Binding ReviewedLocation, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{loc:Loc UI.WhatWillHappen}"
                           Style="{StaticResource LabelText}"
                           Margin="0,16,0,6" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{loc:Loc Residue.CleanupEffects}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
