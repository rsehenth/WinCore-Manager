<UserControl x:Class="WinCoreManager.Views.SensorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers"
             xmlns:v="clr-namespace:WinCoreManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SensorVisibility" />
        <v:SensorIconConverter x:Key="SensorIcon" />
        <DataTemplate x:Key="SensorReadingTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Localized Label}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{loc:Localized .}" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{loc:Localized SampleSource}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SampleSource}" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}"
                           Visibility="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=UserControl},
                                                Converter={StaticResource SensorVisibility}}" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{loc:Localized Reason}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Reason}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="100" Value="{Binding Percentage, TargetNullValue=0, Mode=OneWay}"
                             Height="4" Margin="0,5,0,0" HorizontalAlignment="Stretch"
                             IsTabStop="False" AutomationProperties.Name="{loc:Localized Label}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Percentage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <HeaderedContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Sensor}" Margin="0,0,0,8">
                <HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI.Sensors}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Sensors.Intro}" Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </HeaderedContentControl.Header>
            </HeaderedContentControl>
            <!-- Estado do monitoramento e hora da última leitura. -->
            <Border Style="{StaticResource CardBorder}" Padding="14,10">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{loc:Localized AvailableComponentCount, FormatKey=Sensors.AvailableCount}" FontWeight="SemiBold" Margin="0,0,14,4" />
                        <TextBlock Text="{loc:Localized Notices.Count, FormatKey=Sensors.NoticeCount}" Style="{StaticResource CaptionText}" Margin="0,0,14,4" />
                        <TextBlock Text="{loc:Localized LastUpdate}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Localized Status}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,5,0,0">
                    <Button x:Name="SensorPauseButton" Content="{loc:Localized PauseLabel}" Command="{Binding TogglePauseCommand}"
                            MinWidth="96" Margin="0,0,6,4" />
                    <Button x:Name="SensorDetailsButton" Command="{Binding ToggleDetailsCommand}" Margin="0,0,6,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{loc:Loc Sensors.Details}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetails}" Value="True">
                                        <Setter Property="Content" Value="{loc:Loc Sensors.HideDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Sensors.DiskDetails}" Command="{Binding ShowDriveHealthCommand}" Margin="0,0,0,4"
                            Visibility="{Binding CanOpenDriveHealth, Converter={StaticResource SensorVisibility}}" />
                </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="SensorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl x:Name="SensorGroups" ItemsSource="{Binding Groups}" Margin="0,0,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <h:TileGrid MinItemWidth="360" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="18,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                                            <Path Data="{Binding Id, Converter={StaticResource SensorIcon}}" Style="{StaticResource LineIcon}" Width="21" Height="21"
                                                  TextElement.Foreground="{DynamicResource CyanBrush}" />
                                        </Border>
                                        <TextBlock Text="{loc:Localized Name}" Style="{StaticResource CardTitleText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Localized ConditionLabel}" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Unknown">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Healthy">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Attention">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Critical">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Readings}" ItemTemplate="{StaticResource SensorReadingTemplate}" />
                                    <StackPanel Visibility="{Binding HasCpuCoreReadings, Converter={StaticResource SensorVisibility}}">
                                        <Button x:Name="CpuCoresToggle" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Command="{Binding DataContext.ToggleCpuCoresCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="{loc:Localized CpuCoreCount, FormatKey=Sensors.ShowCpuCores}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShowCpuCores, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Content" Value="{loc:Loc Sensors.HideCpuCores}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ItemsControl x:Name="CpuCoreReadings" ItemsSource="{Binding CpuCoreReadings}"
                                                      ItemTemplate="{StaticResource SensorReadingTemplate}" Margin="0,7,0,0"
                                                      Visibility="{Binding DataContext.ShowCpuCores, RelativeSource={RelativeSource AncestorType=UserControl},
                                                                           Converter={StaticResource SensorVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Loc Sensors.Unavailable}" FontWeight="SemiBold" Margin="0,7,0,5"
                           Visibility="{Binding HasItems, ElementName=SensorNotices, Converter={StaticResource SensorVisibility}}" />
                <ItemsControl x:Name="SensorNotices" ItemsSource="{Binding Notices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,7">
                                <Run Text="{loc:Localized Category}" FontWeight="SemiBold" /><Run Text=" · " />
                                <Run Text="{loc:Localized Status}" /><Run Text=". " /><Run Text="{loc:Localized Reason}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
