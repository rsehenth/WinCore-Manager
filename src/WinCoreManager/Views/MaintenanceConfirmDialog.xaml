<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.MaintenanceConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        Title="{loc:Loc UI.ConfirmOperation}"
        Width="580"
        SizeToContent="Height"
        MaxWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Ações -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource GridLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc UI.Cancel}"
                        IsCancel="True"
                        IsDefault="True"
                        MinWidth="110"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Content="{loc:Loc UI.Run}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,28,28,24">
            <!-- Título -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource IconTile}" Background="{DynamicResource WarningSubtleBrush}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE7BA;"
                               Style="{StaticResource IconText}"
                               FontSize="18"
                               Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:Localized Title}"
                           FontFamily="{StaticResource FontDisplay}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Descrição -->
            <TextBlock Text="{loc:Localized Description}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <!-- Comando -->
            <TextBlock Text="{loc:Loc UI.CommandToRun}" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
            <Border Background="{DynamicResource InsetBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="14,10"
                    Margin="0,0,0,20">
                <TextBlock Text="{Binding CommandText}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12.5"
                           Foreground="{DynamicResource AccentTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Efeitos -->
            <TextBlock Text="{loc:Loc UI.PossibleEffects}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
            <TextBlock Text="{loc:Localized Effects}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <!-- Duração e elevação -->
            <Border Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE121;" Style="{StaticResource IconText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc UI.TypicalDuration}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{loc:Localized TypicalDuration}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc UI.RequiresAdministratorApprovalUAC}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- Unidade (CHKDSK) -->
            <StackPanel Margin="0,20,0,0"
                        Visibility="{Binding DriveSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc UI.DriveToScan}" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding DriveLetters}"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                          Width="140"
                          AutomationProperties.Name="{loc:Loc UI.DriveToScan}"
                          HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
