<Window x:Class="WinCoreManager.Views.DiskHealthDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Title="{loc:Loc DiskHealth.Title}" Width="710" Height="600" MinWidth="360" MinHeight="310"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="18">
        <Button DockPanel.Dock="Bottom" Content="{loc:Loc UI.Close}" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{loc:Loc DiskHealth.Overview}" Style="{StaticResource SectionText}" />
                <TextBlock x:Name="Overview" TextWrapping="Wrap" Margin="0,6,10,14" />
                <TextBlock Text="{loc:Loc DiskHealth.SmartData}" Style="{StaticResource SectionText}" />
                <TextBlock x:Name="Origin" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,10,8" />
                <ItemsControl x:Name="Metrics">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GridLineBrush}" Padding="0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Values}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Meaning}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Loc DiskHealth.Understand}" Style="{StaticResource SectionText}" Margin="0,14,0,4" />
                <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,10,8" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
