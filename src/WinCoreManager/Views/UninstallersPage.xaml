<UserControl x:Class="WinCoreManager.Views.UninstallersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBooleanConverter x:Key="InverseBool" />
        <h:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <h:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MaxHeight="170">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLog}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Localized StatusText}"
                       Style="{StaticResource PageSubtitleText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Barra de ferramentas -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                <Grid Width="140">
                    <TextBox x:Name="SearchBox"
                             Padding="34,0,10,0"
                             AutomationProperties.Name="{loc:Loc UI.FilterPrograms}"
                             ToolTip="{loc:Loc UI.FilterByNamePublisherOrVersion}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;"
                               Style="{StaticResource IconText}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{loc:Loc UI.Search}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="34,0,10,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Width="236"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc UI.CategoryFilter}"
                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                          SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Loc UI.Apps}" />
                    <ComboBoxItem Content="{loc:Loc UI.Background}" />
                    <ComboBoxItem Content="{loc:Loc UI.DevelopmentTools}" />
                    <ComboBoxItem Content="{loc:Loc UI.AllApps}" />
                    <ComboBoxItem Content="{loc:Loc UI.TechnicalComponentsAdvanced}" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="{loc:Loc UI.SelectAll}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          IsChecked="{Binding AllSelected, Mode=TwoWay}" />

                <Button Padding="12,0"
                        AutomationProperties.Name="{loc:Loc UI.RefreshList}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc UI.RefreshList}" />
                    </StackPanel>
                </Button>

                <Button Padding="12,0"
                        AutomationProperties.Name="{loc:Loc UI.UninstallSelected}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding UninstallSelectedCommand}"
                        ToolTip="{Binding DataContext.Updates.PackageChangeBlockReason, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTipService.ShowOnDisabled="True"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc UI.UninstallSelected}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </WrapPanel>

        <!-- Lista de programas + estado vazio -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ProgramsGrid"
                              VerticalScrollBarVisibility="Visible"
                              Margin="6,0"
                              ItemsSource="{Binding Catalog}"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              Sorting="OnProgramsSorting"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              RowHeight="40"
                              HeadersVisibility="Column"
                              AutomationProperties.Name="{loc:Loc UI.InstalledProgramsList}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="{loc:Loc UI.SelectProgram}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Loc UI.Name}" Binding="{Binding Name}" Width="*" MinWidth="220" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.InstallationDate}" Binding="{loc:Localized InstallDate, NumberFormat=d, NullText=—}"
                                                SortMemberPath="InstallDate" Width="158" MinWidth="154" IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="{loc:Loc Uninstaller.InstallDateHelp}" />
                                        <Style.Triggers>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Loc Uninstaller.Ascending}" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Loc Uninstaller.Descending}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Version2}" Binding="{Binding DisplayVersion}" Width="120" MinWidth="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding DisplayVersion}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Publisher}" Binding="{Binding Publisher}" Width="180" MinWidth="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Publisher}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Category}" Binding="{loc:Localized CategoryLabel}" Width="150" MinWidth="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ProtectionInfo}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Type}" Binding="{loc:Localized KindLabel}" Width="150" MinWidth="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status: glifo + texto, cor vinda do ViewModel -->
                            <DataGridTemplateColumn Header="{loc:Loc UI.Status}" Width="150" MinWidth="120" SortMemberPath="StatusText" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="statusIcon"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="12"
                                                       Width="14"
                                                       Margin="0,0,8,0"
                                                       Foreground="{Binding StatusBrush}" />
                                            <TextBlock Text="{loc:Localized StatusText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Queued">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE121;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Running">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE895;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Success">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="SuccessRebootRequired">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Failed">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE711;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Cancelled">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE71A;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="NotExecutable">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rodapé da tabela: contadores de exibição + seleção -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11"
                            Padding="18,0"
                            Height="36">
                        <Grid>
                            <TextBlock Text="{loc:Localized SummaryText}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       ToolTip="{loc:Localized InventoryText}" />
                            <TextBlock Text="{loc:Localized SelectedCount, FormatKey=Common.SelectedCount}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Estado vazio -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,36"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource IconTile}" Width="56" Height="56" CornerRadius="8">
                    <TextBlock Text="&#xE74D;"
                               Style="{StaticResource IconText}"
                               FontSize="24"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:Localized EmptyStateTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="{loc:Localized StatusText}"
                           Style="{StaticResource CaptionText}"
                           FontSize="13"
                           TextAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Detalhes do programa selecionado -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Padding="16,14"
                Margin="0,16,0,0"
                Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedRow.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding SelectedRow.DisplayVersion, Mode=OneWay}" /><Run Text="  ·  " />
                                <Run Text="{Binding SelectedRow.Publisher, Mode=OneWay}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.CategoryLabel}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.KindLabel}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.Origin}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.InstallDate, NumberFormat=d, NullText=—}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.EstimatedSizeText, BinarySizes=True}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{loc:Localized SelectedRow.ProtectionInfo}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding SelectedRow.ProtectionInfo, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding SelectedRow.Program.RegistryPath}"
                                   Style="{StaticResource MonoText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"
                                   ToolTip="{Binding SelectedRow.Program.RegistryPath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Padding="12,0"
                                VerticalAlignment="Top"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanOpenManualResidue}"
                                Click="OnManualResidueScanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc UI.AppAlreadyUninstalled}" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,0"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Top"
                                Command="{Binding OpenResidueScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE912;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc UI.ScanForLeftovers}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{loc:Localized ResidueReport}"
                           Style="{StaticResource MonoText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding ResidueReport, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>

        <!-- Progresso -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorder}"
                Padding="16,14"
                Margin="0,16,0,0"
                Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Localized CurrentOperation}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="{loc:Localized CancelButtonText}"
                            Command="{Binding CancelUninstallCommand}"
                            Margin="16,0,0,0" />
                </Grid>
                <ProgressBar Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             AutomationProperties.Name="{loc:Loc UI.UninstallProgress}"
                             Value="{Binding UninstallProgress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsScanning}" />
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="5"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,16,0,0"
                Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0"
                        Height="32">
                    <TextBlock Text="{loc:Loc UI.Log}" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                </Border>
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:Localized .}"
                                           Style="{StaticResource MonoText}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
