<UserControl x:Class="WinCoreManager.Views.UninstallersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:h="clr-namespace:WinCoreManager.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBooleanConverter x:Key="InverseBool" />
        <h:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <h:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="ProgramSelectionCheckBox" TargetType="CheckBox">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" BorderThickness="1.5" CornerRadius="3"
                                    Background="{DynamicResource InsetBgBrush}"
                                    BorderBrush="{DynamicResource TextSecondaryBrush}" />
                            <Path x:Name="Tick" Data="M 0,4 L 4,8 L 11,0" StrokeThickness="2"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" Margin="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid Height="{Binding ViewportHeight, ElementName=PageScroll}" MinHeight="510">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="172" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MaxHeight="170">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLog}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <HeaderedContentControl Style="{StaticResource PageHeader}" Tag="{StaticResource Icon.Trash}" Margin="0">
                <HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Localized StatusText}" Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </HeaderedContentControl.Header>
            </HeaderedContentControl>
            <h:TileGrid x:Name="SummaryCards" MinItemWidth="200" Margin="0,14,-12,-12">
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Path Data="{StaticResource Icon.Box}" Style="{StaticResource LineIcon}" Width="24" Height="24" Margin="0,0,14,0"
                              TextElement.Foreground="{DynamicResource CyanBrush}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Uninstaller.CardApps}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AppCount}" Style="{StaticResource ValueText}" FontSize="20" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Path Data="{StaticResource Icon.Chart}" Style="{StaticResource LineIcon}" Width="24" Height="24" Margin="0,0,14,0"
                              TextElement.Foreground="{DynamicResource PurpleBrush}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Uninstaller.CardListed}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Catalog.Count}" Style="{StaticResource ValueText}" FontSize="20" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource LineIcon}" Width="24" Height="24" Margin="0,0,14,0"
                              TextElement.Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Uninstaller.CardSelected}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource ValueText}" FontSize="20" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource LineIcon}" Width="24" Height="24" Margin="0,0,14,0"
                              TextElement.Foreground="{DynamicResource WarningBrush}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Uninstaller.CardTechnical}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TechnicalCount}" Style="{StaticResource ValueText}" FontSize="20" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </h:TileGrid>
            <Border x:Name="UninstallRecoveryNotice" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,8,0,0"
                    Visibility="{Binding PendingRecoveryNotice, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc UpdateOperation.RecoveryUninstallBlocked}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Localized PendingRecoveryNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    <Button Content="{loc:Loc UpdateOperation.OpenRecovery}" Command="{Binding OpenPackageRecoveryCommand}"
                            HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Barra de ferramentas -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
        <WrapPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                <Grid Width="140">
                    <TextBox x:Name="SearchBox"
                             Padding="34,0,10,0"
                             AutomationProperties.Name="{loc:Loc UI.FilterPrograms}"
                             ToolTip="{loc:Loc UI.FilterByNamePublisherOrVersion}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;"
                               Style="{StaticResource IconText}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{loc:Loc UI.Search}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="34,0,10,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Width="236"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc UI.CategoryFilter}"
                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                          SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Loc UI.Apps}" />
                    <ComboBoxItem Content="{loc:Loc UI.Background}" />
                    <ComboBoxItem Content="{loc:Loc UI.DevelopmentTools}" />
                    <ComboBoxItem Content="{loc:Loc UI.AllApps}" />
                    <ComboBoxItem Content="{loc:Loc UI.TechnicalComponentsAdvanced}" />
                </ComboBox>
            </StackPanel>

                <CheckBox Content="{loc:Loc Uninstaller.SelectVisible}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,6"
                          IsEnabled="{Binding CanSelectAll}"
                          ToolTip="{loc:Loc Uninstaller.SelectionScope}"
                          AutomationProperties.HelpText="{loc:Loc Uninstaller.SelectionScope}"
                          IsChecked="{Binding AllSelected, Mode=TwoWay}" />

            <Button Content="{loc:Loc Optional.Open}" Click="OnOptionalApps" Margin="0,0,8,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Padding="12,0"
                        AutomationProperties.Name="{loc:Loc UI.RefreshList}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc UI.RefreshList}" />
                    </StackPanel>
                </Button>

                <Button Padding="12,0"
                        AutomationProperties.Name="{loc:Loc UI.UninstallSelected}"
                        AutomationProperties.HelpText="{loc:Localized UninstallSelectedDisabledReason}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding UninstallSelectedCommand}"
                        ToolTip="{loc:Localized UninstallSelectedDisabledReason, NullText={x:Null}}"
                        ToolTipService.ShowOnDisabled="True"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc UI.UninstallSelected}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="UninstallAvailability" Text="{loc:Localized UninstallSelectedDisabledReason}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,4"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding UninstallSelectedDisabledReason, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- Lista de programas + estado vazio -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ProgramsGrid"
                              VerticalScrollBarVisibility="Visible"
                              Margin="6,0"
                              ItemsSource="{Binding Catalog}"
                              IsReadOnly="True"
                              FrozenColumnCount="1"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Single"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                              PreviewKeyDown="OnProgramsPreviewKeyDown"
                              Sorting="OnProgramsSorting"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              RowHeight="40"
                              HeadersVisibility="Column"
                              AutomationProperties.Name="{loc:Loc UI.InstalledProgramsList}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Uninstaller.MarkColumn}" Width="84" MinWidth="84"
                                                    CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ProgramSelectionCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  ToolTip="{loc:Localized SelectionHelp, NullText={x:Null}}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  AutomationProperties.HelpText="{loc:Localized SelectionHelp}"
                                                  AutomationProperties.Name="{loc:Localized Name, FormatKey=Uninstaller.MarkProgram, Translate=False}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Loc UI.Name}" Binding="{Binding Name}" Width="*" MinWidth="220" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.InstallationDate}" Binding="{loc:Localized InstallDate, NumberFormat=d, NullText=—}"
                                                SortMemberPath="InstallDate" Width="158" MinWidth="154" IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="{loc:Loc Uninstaller.InstallDateHelp}" />
                                        <Style.Triggers>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Loc Uninstaller.Ascending}" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter Property="AutomationProperties.ItemStatus" Value="{loc:Loc Uninstaller.Descending}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Version2}" Binding="{Binding DisplayVersion}" Width="120" MinWidth="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding DisplayVersion}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Publisher}" Binding="{Binding Publisher}" Width="180" MinWidth="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Publisher}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Category}" Binding="{loc:Localized CategoryLabel}" Width="150" MinWidth="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ProtectionInfo}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Type}" Binding="{loc:Localized KindLabel}" Width="150" MinWidth="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status: glifo + texto, cor vinda do ViewModel -->
                            <DataGridTemplateColumn Header="{loc:Loc UI.Status}" Width="150" MinWidth="120" SortMemberPath="StatusText" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="statusIcon"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="12"
                                                       Width="14"
                                                       Margin="0,0,8,0"
                                                       Foreground="{Binding StatusBrush}" />
                                            <TextBlock Text="{loc:Localized StatusText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Queued">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE121;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Running">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE895;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Success">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="SuccessRebootRequired">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Failed">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE711;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="Cancelled">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE71A;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{loc:Localized Status}" Value="NotExecutable">
                                                <Setter TargetName="statusIcon" Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rodapé da tabela: contadores de exibição + seleção -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SubtleBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11"
                            Padding="12,6"
                            MinHeight="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Localized SummaryText}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,12,0"
                                       ToolTip="{loc:Localized InventoryText}" />
                            <TextBlock Grid.Column="1" Text="{loc:Localized SelectedCount, FormatKey=Common.SelectedCount}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Estado vazio -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,36"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource IconTile}" Width="56" Height="56" CornerRadius="8">
                    <TextBlock Text="&#xE74D;"
                               Style="{StaticResource IconText}"
                               FontSize="24"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:Localized EmptyStateTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="{loc:Localized StatusText}"
                           Style="{StaticResource CaptionText}"
                           FontSize="13"
                           TextAlignment="Center"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Detalhes do programa selecionado -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Padding="16,14"
                Margin="0,16,0,0"
                Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedRow.Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding SelectedRow.DisplayVersion, Mode=OneWay}" /><Run Text="  ·  " />
                                <Run Text="{Binding SelectedRow.Publisher, Mode=OneWay}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.CategoryLabel}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.KindLabel}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.Origin}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.InstallDate, NumberFormat=d, NullText=—}" /><Run Text="  ·  " />
                                <Run Text="{loc:Localized SelectedRow.EstimatedSizeText, BinarySizes=True}" />
                            </TextBlock>
                        <TextBlock Text="{loc:Localized SelectedRow.ProtectionInfo}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding SelectedRow.ProtectionInfo, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{loc:Localized SelectedRow.UnavailableReason}"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedRow.UnavailableReason, Converter={StaticResource NullToCollapsed}}" />
                        <Button Content="{loc:Loc Message.Uninstaller.OpenWindowsApps}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Command="{Binding OpenWindowsInstalledAppsCommand}"
                                Visibility="{Binding ShowWindowsUninstall, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SelectedRow.Program.RegistryPath}"
                                   Style="{StaticResource MonoText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"
                                   ToolTip="{Binding SelectedRow.Program.RegistryPath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Padding="12,0"
                                VerticalAlignment="Top"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanOpenManualResidue}"
                                Click="OnManualResidueScanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc UI.AppAlreadyUninstalled}" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,0"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Top"
                                Command="{Binding OpenResidueScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE912;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc UI.ScanForLeftovers}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{loc:Localized ResidueReport}"
                           Style="{StaticResource MonoText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding ResidueReport, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>

        <!-- Progresso -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorder}"
                Padding="16,14"
                Margin="0,16,0,0"
                Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Localized CurrentOperation}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="{loc:Localized CancelButtonText}"
                            Command="{Binding CancelUninstallCommand}"
                            Margin="16,0,0,0" />
                </Grid>
                <ProgressBar Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             AutomationProperties.Name="{loc:Loc UI.UninstallProgress}"
                             Value="{Binding UninstallProgress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="5"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,16,0,0"
                Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0"
                        Height="32">
                    <TextBlock Text="{loc:Loc UI.Log}" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                </Border>
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:Localized .}"
                                           Style="{StaticResource MonoText}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
