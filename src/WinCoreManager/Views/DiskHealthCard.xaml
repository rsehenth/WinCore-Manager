<UserControl x:Class="WinCoreManager.Views.DiskHealthCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DiskCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="20,16,20,8" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Selo de estado: tom + glifo + texto. -->
        <Style x:Key="HealthBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Healthy">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Attention">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Text" Value="&#xE9CE;" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Healthy">
                    <Setter Property="Text" Value="&#xE73E;" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Attention">
                    <Setter Property="Text" Value="&#xE7BA;" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                    <Setter Property="Text" Value="&#xEA39;" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Medidor de vida útil. A trilha usa ToggleOffBrush para continuar distinta em alto contraste. -->
        <Style x:Key="LifeMeter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ToggleOffBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthState}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthState}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadingValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="MissingValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="DiskTemplate">
            <Border Style="{StaticResource DiskCard}">
                <DockPanel>
                    <!-- Rodapé: observação à esquerda, ação à direita. Fica embaixo mesmo em cards de alturas iguais. -->
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GridLineBrush}"
                            Padding="0,8,0,0" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnDetails"
                                    VerticalAlignment="Center" Margin="8,0,-8,0"
                                    AutomationProperties.Name="{loc:Loc DiskHealth.Details}"
                                    AutomationProperties.HelpText="{Binding Model}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc DiskHealth.Details}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="10" Margin="8,1,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Localized Note}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                <!-- Origem da leitura: só na versão detalhada. -->
                                <Grid Visibility="{Binding Detailed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Localized Source}" Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding ReadingAvailable, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Identidade: plaqueta do tipo, modelo, capacidade e selo. -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="40" Margin="0,0,12,0" VerticalAlignment="Top"
                                Background="{DynamicResource SubtleBgBrush}" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderStrongBrush}" CornerRadius="{StaticResource RadiusMd}">
                            <Grid>
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                           LineHeight="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" HorizontalAlignment="Center"
                                           Visibility="{Binding HasUnknownType, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <!-- Até duas linhas; o restante fica no ToolTip. -->
                            <TextBlock Text="{loc:Localized Model}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" />
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="{loc:Localized Capacity}" Style="{StaticResource CaptionText}" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localized Volumes}" Style="{StaticResource CaptionText}" />
                            </WrapPanel>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource HealthBadge}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BadgeGlyph}" />
                                <TextBlock Text="{loc:Localized BadgeText}" Style="{StaticResource BadgeText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <!-- Leituras principais: vida útil e temperatura. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc DiskHealth.LifeLabel}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Remaining}" Style="{StaticResource ReadingValue}"
                                           Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{loc:Localized Remaining}" Style="{StaticResource MissingValue}"
                                           Visibility="{Binding HasNoRemaining, Converter={StaticResource BoolToVis}}" />
                                <Grid Margin="0,6,0,0" Height="6" UseLayoutRounding="True">
                                    <Grid Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Style="{StaticResource LifeMeter}" Value="{Binding RemainingValue, Mode=OneWay}"
                                                     AutomationProperties.Name="{loc:Loc DiskHealth.LifeLabel}" />
                                        <!-- Marcas de 10%. -->
                                        <UniformGrid Rows="1" IsHitTestVisible="False">
                                            <UniformGrid.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0,0,2,0" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBgBrush}" />
                                                </Style>
                                            </UniformGrid.Resources>
                                            <Border /><Border /><Border /><Border /><Border />
                                            <Border /><Border /><Border /><Border /><Border BorderThickness="0" />
                                        </UniformGrid>
                                    </Grid>
                                    <Line X2="1" Stretch="Fill" Height="1" VerticalAlignment="Center" StrokeThickness="1"
                                          StrokeDashArray="4 4" Stroke="{DynamicResource BorderControlBrush}"
                                          Visibility="{Binding HasNoRemaining, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource GridLineBrush}"
                                    Margin="16,0,0,0" Padding="16,0,0,0" MinWidth="112">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc DiskHealth.Metric.Temperature}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding Temperature}" Style="{StaticResource ReadingValue}"
                                               Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Localized Temperature}" Style="{StaticResource MissingValue}"
                                               Visibility="{Binding HasNoTemperature, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Somente na versão detalhada (Manutenção): contadores já lidos do disco. -->
                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,16,0,-8"
                                      Visibility="{Binding Detailed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel MinWidth="120" Margin="0,0,24,8">
                                        <TextBlock Text="{loc:Localized Label}" Style="{StaticResource FieldLabelText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding Flagged, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{loc:Localized Value}" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Cabeçalho da seção, direto no canvas: os cards são dos discos. -->
        <!-- Recuo igual ao dos cartões, para alinhar bloco de ícone, título e botão com o resto da página. -->
        <Grid Margin="21,0,21,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="18"
                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc DiskHealth.Title}" Style="{StaticResource SectionText}" FontSize="17" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{loc:Localized Subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap"
                           Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{loc:Localized Captured}" Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                    VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc DiskHealth.Refresh}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc DiskHealth.Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Carregando, sem discos ou falha antes da primeira leitura. -->
        <Border x:Name="EmptyState" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{loc:Localized Status}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="DiskList" ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource DiskTemplate}"
                      Margin="0,0,-12,-12" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="{Binding ItemWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
