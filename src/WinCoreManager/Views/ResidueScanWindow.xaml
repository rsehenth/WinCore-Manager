<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.ResidueScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        xmlns:helpers="clr-namespace:WinCoreManager.Helpers"
        Title="{loc:Loc UI.AdvancedLeftoverCleanup}"
        Width="980"
        Height="700"
        MinWidth="400"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="ResidueTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Underline" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent" Padding="12,7">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource SubtleBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource IconTile}" Background="{DynamicResource AccentSubtleBrush}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE912;"
                               Style="{StaticResource IconText}"
                               FontSize="18"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localized Title}" Style="{StaticResource PageTitleText}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{loc:Loc UI.App}" /><Run Text="{Binding ProgramDisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{loc:Localized ProgramDetails}" Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Filtros e ações -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox
                      MinWidth="170"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{loc:Loc UI.FilterByConfidence}"
                      ItemsSource="{Binding ConfidenceOptions}"
                      ItemTemplate="{StaticResource LocalizedStringTemplate}"
                      SelectedItem="{Binding SelectedConfidence}" />

            <CheckBox
                      Content="{loc:Loc UI.SelectEligibleItems}"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsChecked="{Binding SelectAllEligible, Mode=TwoWay}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

            <Button
                    Padding="12,0"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center"
                    Command="{Binding CleanupSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Localized SelectedCount, FormatKey=Residue.CleanSelected}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Lista de resíduos -->
        <DockPanel Grid.Row="2">
            <Expander x:Name="ResultDetails" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                      Header="{loc:Loc ResidueAdvanced.Details}" Visibility="{Binding Location, Converter={StaticResource NullToCollapsed}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="112" Padding="8,4">
                    <StackPanel>
                        <TextBlock Text="{Binding Location}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailedValue}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Localized Justification}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <TabControl x:Name="ResultTabs" SelectionChanged="OnResultTabChanged"
                        Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource GridLineBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}">
                <TabItem Header="{loc:Loc ResidueAdvanced.Files}" Style="{StaticResource ResidueTab}">
                    <DataGrid x:Name="FileResults" SelectionChanged="OnResultSelected"
                              Margin="6,0"
                              ItemsSource="{Binding Rows}"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeight="36"
                              HeadersVisibility="Column"
                              AutomationProperties.Name="{loc:Loc UI.LeftoversFound}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"
                                                  AutomationProperties.Name="{loc:Loc UI.SelectLeftoverForCleanup}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Loc UI.Category}" Binding="{loc:Localized CategoryLabel}" Width="88" IsReadOnly="True" />
                            <DataGridTextColumn Header="{loc:Loc UI.Confidence}" Binding="{loc:Localized ConfidenceLabel}" Width="116" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{Binding ConfidenceBrush}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Location}" Binding="{Binding Location}" Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Location}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Reason}" Binding="{loc:Localized Justification}" Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{loc:Localized Justification}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Size}" Binding="{loc:Localized SizeText, BinarySizes=True}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{loc:Loc ResidueAdvanced.Registry}" Style="{StaticResource ResidueTab}">
                    <DataGrid x:Name="RegistryResults" SelectionChanged="OnResultSelected"
                              Margin="6,0"
                              ItemsSource="{Binding Rows}"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeight="36"
                              HeadersVisibility="Column"
                              AutomationProperties.Name="{loc:Loc UI.LeftoversFound}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"
                                                  AutomationProperties.Name="{loc:Loc UI.SelectLeftoverForCleanup}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTextColumn Header="{loc:Loc UI.Confidence}" Binding="{loc:Localized ConfidenceLabel}" Width="116" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{Binding ConfidenceBrush}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc ResidueAdvanced.KeyPath}" Binding="{Binding Location}" Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Location}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc UI.Reason}" Binding="{loc:Localized Justification}" Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{loc:Localized Justification}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc ResidueAdvanced.ValueType}" Binding="{Binding ValueDetails}"
                                                Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Progresso -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Padding="16,12"
                Margin="0,12,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Localized CurrentOperation}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc UI.Cancel}"
                            Command="{Binding CancelCommand}"
                            Margin="16,0,0,0" />
                </Grid>
                <ProgressBar Margin="0,10,0,0"
                             Minimum="0"
                             Maximum="100"
                             AutomationProperties.Name="{loc:Loc UI.CleanupProgress}"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsScanning}" />
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,12,0,0"
                MaxHeight="140"
                Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                <ItemsControl ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{loc:Localized .}" Style="{StaticResource MonoText}" TextWrapping="Wrap" FontSize="11.5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Quarentena -->
        <Expander Grid.Row="5"
                  Margin="0,12,0,0"
                  Header="{loc:Localized QuarantineEntries.Count, FormatKey=Residue.Quarantine}"
                  Visibility="{Binding HasQuarantineEntries, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardBorder}" Padding="10" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QuarantineEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="{loc:Localized RestoreLabel}"
                                            IsEnabled="{Binding CanRestore}"
                                            ToolTip="{loc:Localized RestoreUnavailableReason}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Padding="10,2"
                                            Margin="0,0,10,0"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Localized CategoryLabel}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding OriginalPath}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding OriginalPath}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{loc:Localized Entry.Timestamp.LocalDateTime, NumberFormat=g}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Barra inferior -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Localized StatusText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="{loc:Loc UI.Close}"
                    MinWidth="110"
                    IsCancel="True"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
