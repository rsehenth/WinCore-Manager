<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.ManualResidueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        Title="{loc:Loc UI.ScanForLeftoversFromAnUninstalledApp}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        FontSize="14">

    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="{loc:Loc UI.EnterTheInformationYouHaveAboutTheApp}"
                   FontFamily="{StaticResource FontDisplay}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />
        <TextBlock Text="{loc:Loc UI.TheScanUsesTheAppNamePublisherAnd}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16" />

        <TextBlock Text="{loc:Loc UI.AppNameRequired}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox"
                 Padding="8,6"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="{loc:Loc UI.AppName}" />

        <TextBlock Text="{loc:Loc UI.PublisherOptional}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
        <TextBox x:Name="PublisherBox"
                 Padding="8,6"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="{loc:Loc UI.AppPublisher}" />

        <TextBlock Text="{loc:Loc UI.KnownInstallationFolderOptional}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
        <TextBox x:Name="LocationBox"
                 Padding="8,6"
                 Margin="0,0,0,18"
                 AutomationProperties.Name="{loc:Loc UI.InstallationFolder}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Loc UI.TheScanDoesNotRemoveAnyFilesReview}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="{loc:Loc UI.Cancel}" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    x:Name="AnalyzeButton"
                    Content="{loc:Loc UI.Scan}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Click="OnAnalyzeClick"
                    IsDefault="True" />
        </Grid>
    </StackPanel>
</Window>
