<Window Icon="pack://application:,,,/WinCoreManager;component/Assets/app.ico" x:Class="WinCoreManager.Views.LocalizedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Title="{loc:Localized DialogTitle}"
        Language="{Binding Language, Source={x:Static loc:LocalizationService.Current}}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="500" MaxHeight="420"
        ResizeMode="NoResize" Background="{DynamicResource WindowBgBrush}">
    <DockPanel Margin="20">
        <WrapPanel x:Name="Actions" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc UI.Cancel}" IsCancel="True" IsDefault="True" Margin="0,0,10,0" />
            <Button x:Name="AcceptButton" Click="Accept" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="270">
            <TextBlock Text="{loc:Localized Message}" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" FontSize="14" />
        </ScrollViewer>
    </DockPanel>
</Window>
