<UserControl x:Class="WinCoreManager.Views.EssentialsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinCoreManager.Localization"
             xmlns:m="clr-namespace:WinCoreManager.Models"
             xmlns:views="clr-namespace:WinCoreManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Essentials.OpenFailed}" TextWrapping="Wrap" Margin="32,8,32,12"
                   Foreground="{DynamicResource DangerTextBrush}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OpenFailed}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1120">
                <TextBlock Text="{loc:Loc Essentials.Title}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Essentials.Subtitle}" Style="{StaticResource PageSubtitleText}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="{loc:Loc Essentials.Intro}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc Essentials.Search}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc Essentials.Filter}" Style="{StaticResource CaptionText}" Margin="12,0,0,4" />
                    <Grid Grid.Row="1">
                        <TextBox x:Name="EssentialsSearch" Padding="34,0,10,0"
                                 AutomationProperties.Name="{loc:Loc Essentials.Search}"
                                 AutomationProperties.HelpText="{loc:Loc Essentials.Placeholder}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="{loc:Loc Essentials.Placeholder}" Margin="34,0,10,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EssentialsSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="CategoryFilter" Grid.Row="1" Grid.Column="1" MinWidth="160" Margin="12,0,0,0"
                              SelectedValuePath="Tag" SelectedValue="{Binding Category, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc Essentials.Filter}">
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.All}" Tag="{x:Static m:AppCategory.All}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.System}" Tag="{x:Static m:AppCategory.System}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.Drivers}" Tag="{x:Static m:AppCategory.Drivers}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.Media}" Tag="{x:Static m:AppCategory.Media}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.Productivity}" Tag="{x:Static m:AppCategory.Productivity}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.Development}" Tag="{x:Static m:AppCategory.Development}" />
                        <ComboBoxItem Content="{loc:Loc Essentials.Category.Ide}" Tag="{x:Static m:AppCategory.Ide}" />
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <Border.Visibility>
                        <Binding Path="IsEmpty" Converter="{StaticResource BoolToVisibility}" />
                    </Border.Visibility>
                    <TextBlock Text="{loc:Loc Essentials.Empty}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>

                <ItemsControl x:Name="AppCards" ItemsSource="{Binding Results}" SizeChanged="OnCardsSizeChanged"
                              KeyboardNavigation.TabNavigation="Continue" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=views:EssentialsPage}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding App.Glyph}" Style="{StaticResource IconText}"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                                <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Origin, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                               FontSize="13" TextWrapping="Wrap" Margin="0,10,0,12" />
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Button HorizontalAlignment="Left" AutomationProperties.Name="{Binding OpenLabel}"
                                                Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=views:EssentialsPage}}"
                                                CommandParameter="{Binding App.Id}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc Essentials.Open}" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
