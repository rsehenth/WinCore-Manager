<Window x:Class="WinCoreManager.Views.OptionalWindowsAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinCoreManager.Localization"
        Title="{loc:Loc Optional.Title}" Width="830" Height="680" MinWidth="380" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <DataTemplate x:Key="AppRow">
            <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,1,0,0" Padding="4,6">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsEnabled="{Binding Eligible}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,5,10,0" />
                    <Expander>
                        <Expander.Header>
                            <StackPanel Margin="2,0,5,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="4,5,0,0">
                            <TextBlock Text="{loc:Localized Impact}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Identity}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Method}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <Button Content="{loc:Loc Optional.Reinstall}" Click="OnStoreLink" HorizontalAlignment="Left"
                                    Visibility="{Binding StoreLinkVisibility}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6" Style="{StaticResource CaptionText}" />
            <ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,7,0,0">
                <Button x:Name="CancelBatch" Content="{loc:Loc UI.Cancel}" Click="OnCancelBatch" Visibility="Collapsed" Margin="0,0,6,0" />
                <Button x:Name="Remove" Content="{loc:Loc Optional.Remove}" Click="OnRemove" IsEnabled="False" Margin="0,0,6,0" />
                <Button x:Name="CloseButton" Content="{loc:Loc UI.Close}" IsCancel="True" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{loc:Loc Optional.Title}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Optional.Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <StackPanel x:Name="Controls">
                    <WrapPanel Margin="0,0,0,3">
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="{loc:Loc UI.Search}" Style="{StaticResource CaptionText}" />
                            <TextBox x:Name="Search" Width="170" AutomationProperties.Name="{loc:Loc UI.Search}" TextChanged="OnFilter" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="{loc:Loc UI.CategoryFilter}" Style="{StaticResource CaptionText}" />
                            <ComboBox x:Name="Category" SelectedIndex="0" Width="180" SelectionChanged="OnFilter"
                                      AutomationProperties.Name="{loc:Loc UI.CategoryFilter}">
                                <ComboBoxItem Content="{loc:Loc Optional.AllCategories}" />
                                <ComboBoxItem Content="{loc:Loc Optional.Suggested}" />
                                <ComboBoxItem Content="{loc:Loc Optional.Others}" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ShowAbsent" Content="{loc:Loc Optional.ShowAbsent}" Margin="0,4,0,0"
                                  Checked="OnFilter" Unchecked="OnFilter" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="{loc:Loc Optional.SelectSuggested}" Click="OnSelectSuggested" Margin="0,0,6,5" />
                        <Button Content="{loc:Loc Optional.SelectEligible}" Click="OnSelectEligible" Margin="0,0,6,5" />
                        <Button Content="{loc:Loc Optional.Clear}" Click="OnClear" Margin="0,0,6,5" />
                        <Button Content="{loc:Loc UI.Refresh}" Click="OnRefresh" Margin="0,0,6,5" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="AppList">
                    <TextBlock x:Name="SuggestedTitle" Text="{loc:Loc Optional.Suggested}" Style="{StaticResource SectionText}" />
                    <ItemsControl x:Name="Suggested" ItemTemplate="{StaticResource AppRow}" Margin="0,4,0,12" />
                    <TextBlock x:Name="OthersTitle" Text="{loc:Loc Optional.Others}" Style="{StaticResource SectionText}" />
                    <ItemsControl x:Name="Others" ItemTemplate="{StaticResource AppRow}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="Empty" Text="{loc:Loc Optional.Empty}" Style="{StaticResource CaptionText}" Visibility="Collapsed" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
